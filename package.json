{
  "name": "dot-movies",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 6001",
    "build": "next build",
    "start": "next start -p 6001",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "letterboxd:import": "tsx cli/import-letterboxd.ts",
    "movies:update-tvdb": "tsx cli/update-watched-movies.ts",
    "watchlist:update-tvdb": "tsx cli/update-watchlist-movies.ts",
    "people:backfill": "tsx cli/backfill-people.ts",
    "people:update-tvdb": "tsx cli/update-people.ts",
    "generate:tvdb": "openapi-ts",
    "release": "changelogen --bump",
    "prepare": "husky",
    "update:deps": "taze -I"
  },
  "dependencies": {
    "@hey-api/openapi-ts": "^0.94.5",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "csv-parse": "^6.2.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "0.45.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.56.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/pg": "8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
